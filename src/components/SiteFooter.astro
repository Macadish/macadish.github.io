---
import { site, instagramUrl, facebookUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site">
  <div class="row">
    <span>Macad·ish — home kitchen, Singapore</span>
    <span>Not selling yet</span>
    <a href="/menu/">Menu</a>
    <a href="/reservations/">Reservations</a>
    <a href="/journal/">Journal</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
    <a href="/#subscribe">Subscribe</a>
    <a href="/rss.xml">RSS</a>
    <span class="social">
      <a href={instagramUrl} rel="me noopener" target="_blank" aria-label="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
          <circle cx="12" cy="12" r="4.1" />
          <circle cx="17.1" cy="6.9" r="1.05" class="dot" />
        </svg>
      </a>

      {
        facebookUrl && (
          <a href={facebookUrl} rel="me noopener" target="_blank" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
              <path d="M15 8.4h-1.3c-1 0-1.5.5-1.5 1.5v1.5H15l-.4 2.6h-2.4V20" />
            </svg>
          </a>
        )
      }
    </span>
    <span class="year">© {year}</span>
  </div>
</footer>

<style>
  footer.site {
    padding: 2.5rem var(--edge) 4rem;
    border-top: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 0.66rem;
    color: var(--muted);
    line-height: 1.9;
  }

  .row {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .row a { color: var(--muted); }
  .row a:hover { color: var(--ink); }
  .contact { color: var(--ink); user-select: all; }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .social a {
    display: inline-flex;
    line-height: 0;
  }

  .social svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .social .dot { fill: currentColor; stroke: none; }
  .year { margin-left: auto; }

  @media (max-width: 620px) {
    .year { margin-left: 0; }
  }
</style>
