---
import Base from '../layouts/Base.astro';

/**
 * Static hosting has no backend, so the form needs a third-party endpoint.
 * Sign up somewhere like Formspree, Web3Forms or Basin, paste the POST URL
 * here, and the form goes live. While this is empty the submit button stays
 * disabled so nothing is silently lost.
 */
const FORM_ENDPOINT = '';
const live = FORM_ENDPOINT.length > 0;
---

<Base
  title="Contact — Macadish"
  description="Questions about the dough, the styles, or anything else. Send an enquiry or email directly."
>
  <div class="page">
    <div class="page-head">
      <h1>Contact</h1>
      <p class="lede">
        Questions about the dough, the styles, or anything else — send it over and
        I will get back to you.
      </p>
    </div>

    <div class="body">
      <form
        class="enquiry"
        method="post"
        action={live ? FORM_ENDPOINT : undefined}
        aria-describedby={live ? undefined : 'form-status'}
      >
        <p class="field">
          <label for="email">Your email</label>
          <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" />
        </p>

        <p class="field">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" required placeholder="What is this about?" />
        </p>

        <p class="field">
          <label for="message">Enquiry</label>
          <textarea id="message" name="message" rows="7" required placeholder="Tell me what you need."></textarea>
        </p>

        {/* spam trap — real people never fill this in */}
        <p class="trap" aria-hidden="true">
          <label for="company">Company</label>
          <input type="text" id="company" name="_gotcha" tabindex="-1" autocomplete="off" />
        </p>

        <p class="actions">
          <button type="submit" disabled={!live}>Send enquiry</button>
        </p>

        {
          !live && (
            <p class="status" id="form-status">
              The form is not connected yet. In the meantime, email me at
              <span class="pick">jon@macadish.com</span>.
            </p>
          )
        }
      </form>

      <aside class="aside">
        <p class="label">Elsewhere</p>
        <p class="pick">jon@macadish.com</p>
        <p class="pick">@macadish</p>
        <p class="small">
          Home kitchen in Singapore, so there is no street address to visit. For
          dates and availability, see <a href="/reservations/">reservations</a>.
        </p>
      </aside>
    </div>
  </div>
</Base>

<style>
  .page {
    max-width: calc(56rem + var(--pad) * 2);
    margin: 0 auto;
    padding-inline: var(--pad);
  }

  .page .page-head { padding-inline: 0; }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: start;
    padding-bottom: 6rem;
  }

  .field { display: grid; gap: 0.45rem; margin: 0 0 1.4rem; }

  label {
    font-family: var(--f-mono);
    font-size: 0.63rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  input,
  textarea {
    font-family: var(--f-mono);
    font-size: 0.85rem;
    line-height: 1.55;
    padding: 0.7rem 0.8rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 0;
    width: 100%;
  }

  textarea { resize: vertical; }

  input::placeholder,
  textarea::placeholder { color: var(--muted); }

  input:focus,
  textarea:focus { border-color: var(--sci); }

  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .actions { margin: 0; }

  button {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.8rem 1.5rem;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink);
    cursor: pointer;
  }

  button[disabled] {
    background: transparent;
    color: var(--muted);
    border-color: var(--rule);
    cursor: not-allowed;
  }

  .status {
    margin: 1rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
    max-width: 44ch;
  }

  .aside {
    border-top: 1px solid var(--ink);
    padding-top: 1rem;
  }

  .aside p { margin: 0 0 0.5rem; }

  .pick {
    font-family: var(--f-mono);
    font-size: 0.82rem;
    color: var(--ink);
    user-select: all;
  }

  .status .pick { font-size: 0.8rem; margin-left: 0.3rem; }

  .aside .small {
    margin-top: 1.1rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .body { grid-template-columns: 1fr; }
  }
</style>
