---
import Base from '../layouts/Base.astro';
import { menu } from '../data/menu';
---

<Base
  title="Menu — Macadish"
  description="Contemporary Neapolitan, alla pala by the slice, rotating experiments, and local flavours across the range. Sample menu, subject to seasonal availability."
>
  <div class="menu-page">
    <div class="page-head">
      <p class="label">Singapore</p>
      <h1>Menu</h1>
      <p class="lede">Sample menu, subject to ingredient availability for the season.</p>
    </div>

    <section class="card">
      {
        menu.map((group) => (
          <div class="menu-group">
            <p class="group-title">{group.title}</p>
            <p class="group-spec">{group.spec}</p>

            {group.items.map((item) => (
              <div class="item">
                <h2>{item.name}</h2>
                <p class="desc">
                  {item.style && (
                    <>
                      <span class="style">{item.style}</span>
                      <span class="sep" aria-hidden="true">|</span>
                    </>
                  )}
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        ))
      }

      <p class="note">Placeholder items for layout only.</p>
    </section>
  </div>
</Base>

<style>
  .menu-page .page-head {
    text-align: center;
    padding-bottom: 0;
  }

  .menu-page .page-head .lede {
    max-width: 46ch;
    margin-inline: auto;
  }

  .card {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--pad) 6rem;
    text-align: center;
  }

  .menu-group + .menu-group { margin-top: clamp(2.75rem, 6vw, 4rem); }

  .group-title {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin: 0;
  }

  .group-spec {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    margin: 0.4rem 0 0;
  }

  /* short centred rule under each group heading */
  .group-spec::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--rule);
    margin: 1.35rem auto 0;
  }

  .item { margin-top: 1.9rem; }

  .item h2 {
    font-family: var(--f-display);
    font-weight: 600;
    font-stretch: 108%;
    font-size: 1.22rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 0.35rem;
    text-wrap: balance;
  }

  .desc {
    margin: 0 auto;
    max-width: 48ch;
    font-size: 0.98rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .style {
    font-family: var(--f-mono);
    font-size: 0.63rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sci);
    white-space: nowrap;
  }

  .sep {
    color: var(--rule);
    margin: 0 0.5rem;
  }

  .note {
    margin: clamp(3rem, 7vw, 4.5rem) auto 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    max-width: 20rem;
    font-family: var(--f-mono);
    font-size: 0.66rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .desc { text-align: center; }
    .style { display: block; margin-bottom: 0.3rem; }
    .sep { display: none; }
  }
</style>
