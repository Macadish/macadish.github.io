---
import Base from '../layouts/Base.astro';
import { menu, glossary } from '../data/menu';
---

<Base
  title="Menu — Macadish"
  description="Contemporary Neapolitan, alla pala by the slice, rotating experiments, and local flavours across the range. Sample menu, subject to seasonal availability."
>
  <div class="menu-page">
    <div class="page-head">
      <p class="label">Singapore</p>
      <h1>Menu</h1>
      <p class="lede">Sample menu, subject to ingredient availability for the season.</p>
    </div>

    <section class="card">
      {
        menu.map((group) => (
          <div class="menu-group">
            <p class="group-title">{group.title}</p>
            <p class="group-spec">{group.note}</p>

            {group.items.map((item) => (
              <div class="item">
                <h2>{item.name}</h2>
                <p class="desc">
                  <span class="style">{item.style}</span>
                  <span class="sep" aria-hidden="true">|</span>
                  <span class="ingredients">{item.ingredients}</span>
                </p>
              </div>
            ))}
          </div>
        ))
      }

      <aside class="glossary">
        {
          glossary.map((g) => (
            <p class="entry">
              <span class="mark" aria-hidden="true">*</span>
              <em>{g.style}</em> — {g.character}, {g.hydration}
            </p>
          ))
        }
      </aside>

      <p class="note">Placeholder items for layout only.</p>
    </section>
  </div>
</Base>

<style>
  .menu-page .page-head {
    text-align: center;
    padding-bottom: 0;
  }

  .menu-page .page-head .lede {
    max-width: 46ch;
    margin-inline: auto;
  }

  .card {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) var(--pad) 6rem;
    text-align: center;
  }

  .menu-group + .menu-group { margin-top: clamp(2.75rem, 6vw, 4rem); }

  /* section divider: rules run out to the column edges on either side */
  .group-title {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 4vw, 1.6rem);
    margin: 0;
    font-family: var(--f-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-indent: 0.3em; /* balance the trailing letter-space */
    text-transform: uppercase;
    color: var(--ink);
  }

  .group-title::before,
  .group-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  /* the note speaks in a different voice from the divider */
  .group-spec {
    font-family: var(--f-body);
    font-style: italic;
    font-size: 0.95rem;
    letter-spacing: 0;
    color: var(--muted);
    margin: 0.85rem 0 0;
  }

  .item { margin-top: 2rem; }

  .menu-group .item:first-of-type { margin-top: 2.4rem; }

  .item h2 {
    font-family: var(--f-display);
    font-weight: 600;
    font-stretch: 108%;
    font-size: 1.22rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 0.35rem;
    text-wrap: balance;
  }

  .desc {
    margin: 0 auto;
    max-width: 52ch;
    font-size: 0.98rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .ingredients { white-space: normal; }

  .style {
    font-family: var(--f-mono);
    font-size: 0.63rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sci);
    white-space: nowrap;
  }

  .sep {
    color: var(--rule);
    margin: 0 0.5rem;
  }

  /* footnotes: same voice throughout, no colour, no heading */
  .glossary {
    margin-top: clamp(3.5rem, 8vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .entry {
    margin: 0 auto 0.4rem;
    max-width: 60ch;
    font-size: 0.78rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .entry em { font-style: italic; }

  .mark { margin-right: 0.3rem; }

  .note {
    margin: clamp(2.75rem, 6vw, 3.75rem) auto 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    max-width: 20rem;
    font-family: var(--f-mono);
    font-size: 0.66rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .desc { text-align: center; }
    .style { display: block; margin-bottom: 0.3rem; }
    .sep { display: none; }
  }
</style>
