---
import Base from '../layouts/Base.astro';
---

<Base
  title="Reservations — Macadish"
  description="Reservations are not open yet. Subscribe to hear first, or get in touch."
>
  <div class="page">
    <p class="label">Reservations</p>
    <h1>Coming soon</h1>

    <p class="lede">
      Not open yet. When dates go up, the mailing list hears first.
    </p>

    <p class="links">
      <a href="/#subscribe">Join the list</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href="/contact/">Get in touch</a>
    </p>
  </div>
</Base>

<style>
  .page {
    max-width: calc(38rem + var(--pad) * 2);
    margin: 0 auto;
    padding: clamp(5rem, 16vh, 9rem) var(--pad) clamp(6rem, 18vh, 10rem);
    text-align: center;
  }

  h1 {
    font-family: var(--f-display);
    font-weight: 700;
    font-stretch: 106%;
    font-size: clamp(2.4rem, 8vw, 4.2rem);
    line-height: 1;
    letter-spacing: -0.034em;
    margin: 0.9rem 0 0;
    text-wrap: balance;
  }

  .lede {
    font-size: 1.08rem;
    color: var(--muted);
    max-width: 34ch;
    margin: 1.2rem auto 0;
    text-wrap: pretty;
  }

  .links {
    margin: 2.4rem 0 0;
    padding-top: 1.6rem;
    border-top: 1px solid var(--rule);
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  .links a {
    color: var(--sci);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .links a:hover { border-bottom-color: var(--sci); }

  .sep { color: var(--rule); margin: 0 0.7rem; }
</style>
